{
  "name": "monica-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MONICA astronaut health-monitoring prototype — Express API for Neon PostgreSQL.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed:sources": "node scripts/seed-sources.js",
    "import:rad": "node scripts/import-msl-rad.js",
    "import:donki": "node scripts/import-donki.js",
    "cleanup:demo": "node scripts/cleanup-demo.js",
    "frontend": "node scripts/serve-frontend.js",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\""
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  }
}
