# MONICA backend configuration. Copy to .env for local development.
# Never commit .env — it is ignored by Git.

# Neon PostgreSQL connection string (Neon console → Connection Details).
# Without this value the API starts but reports that database functionality is unavailable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Long random string used to sign/derive session secrets (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string

# Comma-separated list of browser origins allowed to call the API directly.
# Example: https://monica-yourteam.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Port for the Express server (Render sets PORT automatically).
PORT=8080

# Optional. api.nasa.gov key used for DONKI requests. DEMO_KEY is used when absent
# (DEMO_KEY is heavily rate limited; request a free key at https://api.nasa.gov/).
NASA_API_KEY=

# development | production. Production enables Secure cookies and stricter defaults.
NODE_ENV=development

# Proxy hops to trust for the client IP (used by rate limiting):
#   false (local), true or 1 (browser → Render), 2 (browser → Vercel rewrite → Render).
TRUST_PROXY=false

# Hours a public demo account (and all of its entries) is retained before deletion.
DEMO_RETENTION_HOURS=24

# Optional. Session cookie SameSite policy: lax (default; frontend proxies /api through Vercel,
# so the cookie is first-party) or none (only if the browser calls the Render URL directly
# from another site; forces Secure and is blocked by some browsers' third-party cookie rules).
# COOKIE_SAMESITE=lax

# Test-only: integration tests set DATABASE_SCHEMA to a throwaway schema automatically.
# Do not set it in production.
